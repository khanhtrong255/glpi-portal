# ============================================================
# GLPI Docker Stack - Template (copy thành .env và điền giá trị)
# ============================================================

# --- Project ---
COMPOSE_PROJECT_NAME=glpi

# --- MariaDB ---
MARIADB_ROOT_PASSWORD=change_me_root_password
MARIADB_DATABASE=glpidb
MARIADB_USER=glpiuser
MARIADB_PASSWORD=change_me_glpi_password

# --- GLPI ---
GLPI_VERSION=11.0.7

# Timezone
TZ=Asia/Ho_Chi_Minh

# --- NPM (Nginx Proxy Manager) ---
GLPI_DOMAIN=glpi.yourdomain.com